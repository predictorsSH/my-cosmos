---
import 'katex/dist/katex.min.css';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 한국어 기준 분당 약 500자로 계산
const readingMinutes = Math.max(1, Math.round((post.body ?? '').length / 500));
const date = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article>
    <header class="post-header">
      <p class="post-category">{post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.date.toISOString()}>{date}</time>
        <span>·</span>
        <span>{readingMinutes}분 읽기</span>
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin: 32px 0 48px;
  }

  .post-header h1 {
    font-size: 2rem;
    line-height: 1.3;
    margin: 0.2em 0 0.4em;
  }

  .post-category {
    margin: 0;
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .post-meta {
    display: flex;
    gap: 8px;
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
