---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cosmos from '../components/Cosmos.astro';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="my-cosmos"
  description="AI와 데이터를 공부하고 만든 것들을 기록하는 블로그. 글은 별, 인용한 자료는 위성이 되어 하나의 우주를 이룹니다."
  bare
>
  <Cosmos posts={posts} />
</BaseLayout>
